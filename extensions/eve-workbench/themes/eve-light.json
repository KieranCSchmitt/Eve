    "editor.lineHighlightBackground": "#F2F4F8",
    "editorCursor.foreground": "#5677FF",
    "editorWidget.background": "#FFFFFF",
    "editorWidget.border": "#DFE4ED",
    "editorGroupHeader.tabsBackground": "#F6F7F9",
    "tab.activeBackground": "#FCFCFA",
    "tab.activeForeground": "#18213A",
    "tab.inactiveBackground": "#F6F7F9",
    "tab.inactiveForeground": "#8790A4",
    "tab.border": "#EDF0F5",
    "tab.activeBorderTop": "#5677FF",
    "activityBar.background": "#F8F9FA",
    "activityBar.foreground": "#5677FF",
    "activityBar.inactiveForeground": "#929BAE",
    "activityBar.border": "#E8EBF1",
    "sideBar.background": "#F8F9FA",
    "sideBar.foreground": "#5E6A82",
    "sideBar.border": "#E8EBF1",
    "sideBarSectionHeader.background": "#F1F3F7",
    "list.activeSelectionBackground": "#5677FF18",
    "list.activeSelectionForeground": "#274CC5",
    "list.hoverBackground": "#EDF0F7",
    "statusBar.background": "#F6F7F9",
    "statusBar.foreground": "#768099",
    "statusBar.border": "#E5E9F0",
    "statusBar.noFolderBackground": "#F6F7F9",
    "titleBar.activeBackground": "#FCFCFA",
    "titleBar.activeForeground": "#28324A",
    "panel.background": "#FCFCFA",
    "panel.border": "#E5E9F0",
    "terminal.background": "#FCFCFA",
    "terminal.foreground": "#28324A",
    "input.background": "#FFFFFF",
    "input.border": "#DEE3ED",
    "button.background": "#5677FF",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#4669EC",
    "badge.background": "#5677FF",
    "badge.foreground": "#FFFFFF",
    "scrollbarSlider.background": "#6E7B9425",
    "scrollbarSlider.hoverBackground": "#6E7B9445"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#929BA8", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#7A59A6" } },
    { "scope": ["string"], "settings": { "foreground": "#477D6F" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#B37746" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#4569BD" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#518793" } }
  ]
}
